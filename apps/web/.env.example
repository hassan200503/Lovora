# Leave DATABASE_URL empty locally: an embedded PGlite database is created in .data/.
# In production, use a Neon connection string (sslmode=require).
DATABASE_URL=

# 32+ random characters. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Protects /api/cron/ingest (optional if you only use the GitHub Action).
CRON_SECRET=

# Public origin used in emailed links and Google OAuth redirects. Defaults to the
# request origin on Vercel, but set it explicitly (no trailing slash).
APP_URL=

# Password recovery by email. Set EMAIL_PROVIDER to "resend" or "brevo" (or leave
# it empty and provide exactly one API key). Development without credentials logs
# the code to the server console instead of sending it. EMAIL_FROM accepts either
# "you@example.com" or "Lovora <no-reply@yourdomain.com>".
# Resend needs a verified domain; Brevo works with a verified single sender.
EMAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Lovora

# Google sign-in (OAuth 2.0 web client). Create the client in Google Cloud Console
# and add this authorized redirect URI exactly:
#   https://your-domain/api/auth/google/callback
# GOOGLE_REDIRECT_URI is the full callback URI and overrides the computed value
# when APP_URL cannot be used (for example a preview deployment).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Sign-in details used by `pnpm seed` for the demo couple. Passwords and
# recovery codes are generated and appended to .env.local when empty; they are
# never printed. Use real addresses only in a private deployment.
SEED_ALEX_EMAIL=
SEED_ALEX_PASSWORD=
SEED_ALEX_RECOVERY=
SEED_SAM_EMAIL=
SEED_SAM_PASSWORD=
SEED_SAM_RECOVERY=

# Optional: contact address for Web Push (VAPID) and OpenAlex's polite pool.
VAPID_SUBJECT=
OPENALEX_MAILTO=

# Optional: Research (/research). A free key from aistudio.google.com; it can also be pasted
# in Settings → AI research instead. GEMINI_MODELS overrides the models tried, in order.
GEMINI_API_KEY=
GEMINI_MODELS=

# Optional: live YouTube search and shelves on the gallery. Create a free key in Google
# Cloud with "YouTube Data API v3" enabled. The free quota is 10,000 units/day; a search
# costs 100, details cost 1, and results are cached globally for 30 minutes.
# YOUTUBE_REGION_CODE defaults to KE.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=

# Break-glass plan administration only; leave unset for normal use. See AGENTS.md.
ENTITLEMENTS_ADMIN=
ENTITLEMENTS_ADMIN_ACTOR=

# Feature flags. Every flag defaults to off until its work is finished and legal
# to ship; see src/lib/flags/registry.ts for the list. Only the server reads
# these, so a browser cannot switch one on. `pnpm flags -- --list` prints them.
# FEATURE_FLAGS="paywall=on,screenShare=off"
# FEATURE_FLAG_ALLOWLIST="paywall:<couple-id>"

# Optional: a TURN relay so calls connect on strict mobile networks (set one group), or paste
# it in Settings → Call relay instead. See DEPLOY.md.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
